{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_paths": {"description": "JSON array of repository-relative paths", "type": "string"},
    "data_version": {"minLength": 1, "type": "string"},
    "decision": {"enum": ["keep", "reject", "investigate", "superseded"]},
    "decision_reason": {"minLength": 1, "type": "string"},
    "features": {"description": "JSON array", "type": "string"},
    "git_commit": {"minLength": 1, "type": "string"},
    "model": {"minLength": 1, "type": "string"},
    "model_parameters": {"description": "JSON object", "type": "string"},
    "model_size_mb": {"type": ["number", "string"]},
    "notes": {"type": "string"},
    "overall_cv_rmse": {"type": ["number", "string"]},
    "peak_memory_mb": {"type": ["number", "string"]},
    "regional_or_subgroup_metrics": {"description": "JSON object", "type": "string"},
    "rmse_by_horizon": {"description": "JSON object", "type": "string"},
    "run_date_utc": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "run_id": {"pattern": "^run-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9_-]{0,31}$", "type": "string"},
    "runtime_seconds": {"type": ["number", "string"]},
    "seed": {"type": ["integer", "string"]},
    "submission_score": {"type": ["number", "string"]},
    "validation_version": {"minLength": 1, "type": "string"}
  },
  "required": ["run_id", "run_date_utc", "git_commit", "data_version", "validation_version", "seed", "features", "model", "model_parameters", "decision", "decision_reason"],
  "title": "Drought forecasting experiment registry record",
  "type": "object"
}
